{
  "name": "komari-animal-island-theme",
  "description": "使用 Animal Island UI 构建的温暖游戏风简单的Komari 监控主题",
  "private": true,
  "version": "1.0.8",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
